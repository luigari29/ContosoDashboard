@page "/documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1>My Documents</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#uploadForm">
                Upload Document
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
    }

    <div id="uploadForm" class="collapse @(isUploadVisible ? "show" : "")">
        <div class="card mb-4">
            <div class="card-body">
                <EditForm Model="uploadRequest" OnValidSubmit="HandleUploadAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Document title</label>
                            <InputText class="form-control" @bind-Value="uploadRequest.Title" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <InputSelect class="form-select" @bind-Value="uploadRequest.Category">
                                <option value="">Select a category</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="uploadRequest.Description" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Associated project</label>
                            <InputSelect class="form-select" @bind-Value="uploadRequest.ProjectId">
                                <option value="">Personal document</option>
                                @foreach (var project in availableProjects)
                                {
                                    <option value="@project.ProjectId">@project.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tags</label>
                            <InputText class="form-control" @bind-Value="uploadRequest.Tags" placeholder="e.g. sprint, design, review" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">File</label>
                            <InputFile OnChange="HandleFileSelected" class="form-control" />
                            @if (!string.IsNullOrWhiteSpace(selectedFileName))
                            {
                                <small class="text-muted">Selected: @selectedFileName</small>
                            }
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@isUploading">
                            @(isUploading ? "Uploading..." : "Upload")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input class="form-control" type="text" value="@searchText" @oninput="OnSearchTextChanged" placeholder="Search by title, description, tag, or uploader" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" value="@selectedCategory" @onchange="OnCategoryChanged">
                        <option value="">All categories</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-outline-secondary" type="button" @onclick="RefreshDocumentsAsync">Refresh</button>
                </div>
            </div>

            @if (documents == null)
            {
                <p><em>Loading documents...</em></p>
            }
            else if (!documents.Any())
            {
                <div class="alert alert-info mb-0">No documents found for this view.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Project</th>
                                <th>Uploaded</th>
                                <th>Size</th>
                                <th>Uploader</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in documents)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@document.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(document.Description))
                                        {
                                            <small class="text-muted">@document.Description</small>
                                        }
                                    </td>
                                    <td>@document.Category</td>
                                    <td>@(document.Project?.Name ?? "Personal")</td>
                                    <td>@document.UploadedDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td>@FormatBytes(document.FileSizeBytes)</td>
                                    <td>@document.UploadedByUser.DisplayName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly UploadDocumentRequest uploadRequest = new();
    private List<ContosoDashboard.Models.Document> documents = new();
    private List<Project> availableProjects = new();
    private IReadOnlyList<string> categories = new[]
    {
        "Project Documents",
        "Team Resources",
        "Personal Files",
        "Reports",
        "Presentations",
        "Other"
    };

    private int currentUserId;
    private string searchText = string.Empty;
    private string selectedCategory = string.Empty;
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isUploading;
    private bool isUploadVisible = true;
    private IBrowserFile? selectedFile;
    private string selectedFileName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            currentUserId = userId;
            availableProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
            await RefreshDocumentsAsync();
        }
    }

    private async Task HandleUploadAsync()
    {
        if (selectedFile == null)
        {
            statusMessage = "Please choose a file to upload.";
            isError = true;
            return;
        }

        try
        {
            isUploading = true;
            statusMessage = string.Empty;

            await using var stream = selectedFile.OpenReadStream(25 * 1024 * 1024);
            var uploaded = await DocumentService.UploadAsync(
                currentUserId,
                uploadRequest.Title,
                uploadRequest.Description,
                uploadRequest.Category,
                uploadRequest.ProjectId,
                stream,
                selectedFile.Name,
                selectedFile.ContentType,
                uploadRequest.Tags);

            statusMessage = $"Document '{uploaded.Title}' was uploaded successfully.";
            isError = false;
            uploadRequest.Title = string.Empty;
            uploadRequest.Description = string.Empty;
            uploadRequest.Category = string.Empty;
            uploadRequest.ProjectId = null;
            uploadRequest.Tags = string.Empty;
            selectedFile = null;
            selectedFileName = string.Empty;
            isUploadVisible = true;
            await RefreshDocumentsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        statusMessage = string.Empty;
    }

    private async Task RefreshDocumentsAsync()
    {
        if (currentUserId == 0)
        {
            return;
        }

        documents = await DocumentService.GetUserDocumentsAsync(currentUserId, searchText, selectedCategory);
    }

    private async Task OnSearchTextChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        await RefreshDocumentsAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? string.Empty;
        await RefreshDocumentsAsync();
    }

    private static string FormatBytes(long bytes)
    {
        const int scale = 1024;
        string[] units = { "B", "KB", "MB", "GB" };

        double value = bytes;
        var index = 0;

        while (value >= scale && index < units.Length - 1)
        {
            value /= scale;
            index++;
        }

        return index == 0 ? $"{(int)value}{units[index]}" : $"{value:0.##}{units[index]}";
    }

    private class UploadDocumentRequest
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public int? ProjectId { get; set; }
        public string Tags { get; set; } = string.Empty;
    }
}
